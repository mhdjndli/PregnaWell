# ============================================================
# Required for the /admin panel
# ============================================================

# The single password to log into /admin. Choose anything strong.
ADMIN_PASSWORD=change-me-to-something-strong

# Postgres connection string. On Railway, add a "Postgres" plugin
# and Railway will set this automatically — leave it blank locally
# unless you want admin to work offline.
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Set to "disable" to turn off SSL on local Postgres.
# Defaults to require-SSL in production.
# PGSSLMODE=disable

# ============================================================
# Optional: "Generate with Gemini" cover image button in admin
# ============================================================

# Google AI Studio API key — enables the "Generate with Gemini"
# button in the blog editor's cover image card. Get one at
# https://aistudio.google.com/app/apikey. If unset, the button
# will return a configuration error when clicked.
# GEMINI_API_KEY=

# ============================================================
# Optional: Relay integration (POST /api/relay/blog)
# ============================================================

# Bearer token that the Relay agent must send in the
# Authorization header to create blog posts via the API.
# Generate with: openssl rand -hex 32
# RELAY_BEARER_TOKEN=

# =======================================================================
# Optional: Google Search Console integration (/admin/search-console)
# =======================================================================

# Paste the ENTIRE JSON key file of a Google Cloud service account that has
# been added as a user (Full permission) on the pregnawell.com property in
# Search Console. Setup steps are shown on /admin/search-console itself.
# GSC_SERVICE_ACCOUNT_JSON={"type":"service_account","client_email":"...","private_key":"..."}

# Alternative to the JSON blob: set the two fields separately.
# GSC_SERVICE_ACCOUNT_EMAIL=pregnawell-gsc@your-project.iam.gserviceaccount.com
# GSC_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# The Search Console property to read. Defaults to the domain property.
# GSC_SITE_URL=sc-domain:pregnawell.com
